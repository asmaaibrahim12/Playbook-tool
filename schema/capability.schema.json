{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taxfix.internal/schema/capability/v1",
  "title": "Capability Manifest",
  "description": "One capability a platform team offers its consuming teams. Fields are ordered by the questions a builder asks, in the order they ask them: what does it do, when should I not use it, does it work where I am, is it good enough, what does it cost, how do I call it, who else relies on it, who do I ask.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "scope",
    "build_your_own_if",
    "availability",
    "evaluation",
    "cost",
    "interface",
    "consumers",
    "support"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "capability.taxfix.internal/v1"
    },
    "kind": {
      "enum": [
        "Capability"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "trunk",
        "owner",
        "summary",
        "lifecycle"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Stable identifier. Never reused after retirement."
        },
        "title": {
          "type": "string"
        },
        "trunk": {
          "enum": [
            "data-and-docs",
            "tax-core-and-submission",
            "monetisation",
            "kyc-aml-pep",
            "user-management",
            "operational-tooling",
            "global-bookkeeping"
          ]
        },
        "owner": {
          "type": "string",
          "description": "Slack handle of the owning team. A person is not a valid owner, because people leave."
        },
        "summary": {
          "type": "string",
          "maxLength": 240
        },
        "lifecycle": {
          "enum": [
            "experimental",
            "beta",
            "stable",
            "deprecated"
          ],
          "description": "experimental = an Orchard built it and it has not graduated. stable = Trunk-owned and supported."
        },
        "graduated_from": {
          "type": "string",
          "description": "The Orchard that originally built this, if it arrived through inner source."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "description": "Question 1: does this do what I need?",
      "required": [
        "does",
        "does_not"
      ],
      "additionalProperties": false,
      "properties": {
        "does": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "does_not": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Explicit non-goals. In practice the most-read field in the manifest."
        }
      }
    },
    "build_your_own_if": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Question 2: should I not use this at all? Conditions under which a consuming team SHOULD build its own. Required, because a catalogue that never says 'don't use me' is discovered as a liar later."
    },
    "availability": {
      "type": "object",
      "description": "Question 3: does it work where I am? Market differences are data here, not forked code.",
      "required": [
        "markets"
      ],
      "additionalProperties": false,
      "properties": {
        "markets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "market",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "market": {
                "enum": [
                  "DE",
                  "UK",
                  "ES"
                ]
              },
              "status": {
                "enum": [
                  "live",
                  "in-progress",
                  "not-supported"
                ]
              },
              "obligation": {
                "type": "string",
                "description": "e.g. UStVA, MTD quarterly update, modelo 303"
              },
              "channel": {
                "type": "string",
                "description": "e.g. ELSTER, HMRC MTD API, AEAT"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "advice_boundary": {
          "type": "object",
          "description": "Where the regulatory line sits for this capability. Configured per capability because Germany is software-only under \u00a73 StBerG while the UK and Spain bundle human review.",
          "additionalProperties": false,
          "required": [
            "automated",
            "requires_licensed_human"
          ],
          "properties": {
            "automated": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requires_licensed_human": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "basis": {
              "type": "string",
              "description": "Legal basis, e.g. \u00a73 StBerG; BFH II R 22/15"
            }
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "description": "Question 4: is it good enough for my risk? The platform owns the method; each consuming team sets its own threshold.",
      "required": [
        "self_service",
        "method",
        "metrics"
      ],
      "additionalProperties": false,
      "properties": {
        "self_service": {
          "type": "boolean",
          "description": "First field on purpose. Can a consuming team run this eval against its own data unaided? If not, the platform team is the only one who can say the capability works, which is a bottleneck on trust."
        },
        "method": {
          "type": "string"
        },
        "eval_set_ref": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "value",
              "measured_on",
              "as_of",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "unit": {
                "type": "string"
              },
              "measured_on": {
                "type": "string",
                "description": "Which eval set or population."
              },
              "as_of": {
                "type": "string",
                "format": "date"
              },
              "source": {
                "enum": [
                  "measured",
                  "assumed"
                ],
                "description": "Where this number came from. 'assumed' means nobody measured it \u2014 a placeholder showing the shape of the field. Machine-readable on purpose, so a consuming team never mistakes a guess for a result."
              }
            }
          }
        },
        "known_failure_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_fallback": {
          "type": "string",
          "description": "What happens below the caller's threshold."
        }
      }
    },
    "cost": {
      "type": "object",
      "description": "Question 5: what does it cost me? Required \u2014 a capability nobody can price is a capability nobody can budget for.",
      "required": [
        "unit",
        "measure",
        "as_of",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string",
          "description": "e.g. per document processed"
        },
        "amount_eur": {
          "type": "number"
        },
        "measure": {
          "type": "string",
          "description": "State cost per SUCCESSFUL outcome, not per call. A cheap call that fails and escalates to a human expert is the expensive one."
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "enum": [
            "measured",
            "assumed"
          ],
          "description": "As above. A costed capability nobody has measured is still a guess."
        }
      }
    },
    "interface": {
      "type": "object",
      "description": "Question 6: how do I call it? Last of the decision fields, because nobody needs an entrypoint for a capability they have decided against.",
      "required": [
        "protocol",
        "entrypoint"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "http",
            "grpc",
            "event",
            "library",
            "mcp"
          ]
        },
        "entrypoint": {
          "type": "string"
        },
        "spec_ref": {
          "type": "string",
          "description": "Reference to the OpenAPI or AsyncAPI document. Referenced, never copied, so the spec stays single-source."
        },
        "auth": {
          "type": "string"
        },
        "sdk": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "consumers": {
      "type": "array",
      "description": "Question 7: who else relies on this? Reach is read from here rather than asserted in a planning meeting.",
      "items": {
        "type": "object",
        "required": [
          "orchard",
          "since"
        ],
        "additionalProperties": false,
        "properties": {
          "orchard": {
            "enum": [
              "self-serve",
              "assisted",
              "business"
            ]
          },
          "since": {
            "type": "string",
            "format": "date"
          },
          "market": {
            "enum": [
              "DE",
              "UK",
              "ES"
            ]
          },
          "criticality": {
            "enum": [
              "blocking",
              "important",
              "convenience"
            ]
          }
        }
      }
    },
    "support": {
      "type": "object",
      "description": "Question 8: who do I ask, and can I just fix it myself?",
      "required": [
        "channel",
        "contribution"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string"
        },
        "response_target": {
          "type": "string"
        },
        "contribution": {
          "enum": [
            "open",
            "review-required",
            "closed"
          ],
          "description": "Inner source posture. 'open' means raise a PR, not a ticket."
        },
        "contribution_guide": {
          "type": "string"
        }
      }
    }
  }
}
